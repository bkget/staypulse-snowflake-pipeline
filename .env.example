# Copy to .env (gitignored) and fill in. Never commit .env or anything under secrets/.
# Snowflake account identifier in <orgname>-<account_name> form (Snowsight: account menu > copy account identifier)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=SVC_PIPELINE
# Passphrase you chose when generating secrets/pipeline_rsa_key.p8
SNOWFLAKE_KEY_PASSPHRASE=

# Used only when running outside Docker (for example from a local virtualenv). Docker overrides both paths.
# Relative paths are resolved against the repository root.
SNOWFLAKE_KEY_FILE=secrets/pipeline_rsa_key.p8
DATA_DIR=data

# Optional
# CORTEX_FN=ai_classify          # default keyword_stub: Cortex LLM functions are blocked on trial accounts
# AIRFLOW_ADMIN_PASSWORD=admin   # local Airflow UI password, default admin
